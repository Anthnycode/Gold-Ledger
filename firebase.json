{
  "hosting": {
    "site": "goldledger",
    "public": "public",
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
